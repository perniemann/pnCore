{
  "name": "pn-core-mcp",
  "version": "0.19.5",
  "description": "MCP server exposing full pnCore plugin content (skills, agents, commands, rules) for orchestration, skeptic, full dev cycle, research, questionnaire, SVG creator, and all workflows.",
  "author": {
    "name": "perniemann",
    "email": "io@perniemann.com"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/perniemann/pnCore.git"
  },
  "main": "dist/index.js",
  "bin": {
    "pn-core-mcp": "./dist/index.js"
  },
  "scripts": {
    "postinstall": "npm dedupe",
    "prebuild": "node scripts/prune-sdk-nested-zod.mjs",
    "prestart": "node scripts/prune-sdk-nested-zod.mjs",
    "start": "node dist/index.js",
    "build": "npx tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.30.0",
    "typebox": "^1.3.30",
    "zod": "4.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "overrides": {
    "zod": "4.6.1",
    "ip-address": "10.4.0",
    "fast-uri": "3.1.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "content",
    "scripts/prune-sdk-nested-zod.mjs"
  ]
}
