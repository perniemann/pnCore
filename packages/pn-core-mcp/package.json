{
  "name": "pn-core-mcp",
  "version": "0.19.12",
  "description": "MCP engine for pnCore: workflow_step, skills, agents, commands, and rules across Cursor, Claude Code, Codex, and Pi.",
  "author": {
    "name": "perniemann",
    "email": "io@perniemann.com"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/perniemann/pnCore.git"
  },
  "main": "dist/index.js",
  "bin": {
    "pn-core-mcp": "./dist/index.js"
  },
  "scripts": {
    "postinstall": "npm dedupe",
    "prebuild": "node scripts/prune-sdk-nested-zod.mjs",
    "prestart": "node scripts/prune-sdk-nested-zod.mjs",
    "start": "node dist/index.js",
    "build": "npx tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "typebox": "^1.3.34",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "overrides": {
    "zod": "4.6.7",
    "ip-address": "10.7.4",
    "fast-uri": "3.1.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "content",
    "scripts/prune-sdk-nested-zod.mjs"
  ]
}
