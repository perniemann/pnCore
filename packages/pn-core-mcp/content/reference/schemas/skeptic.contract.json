{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pn-core://reference/schemas/skeptic.contract.json",
  "title": "Skeptic Contract",
  "description": "Output contract for the pn-skeptic-challenge agent verdict",
  "type": "object",
  "required": ["scores", "must_fix", "should_fix", "missing_evidence", "visual_evidence", "go_no_go"],
  "additionalProperties": false,
  "properties": {
    "scores": {
      "type": "object",
      "required": ["severity", "confidence"],
      "additionalProperties": false,
      "properties": {
        "severity": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "must_fix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "area", "description", "evidence", "suggested_fix"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "area": { "type": "string" },
          "description": { "type": "string" },
          "evidence": {
            "type": "object",
            "required": ["files", "notes"],
            "additionalProperties": false,
            "properties": {
              "files": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "array", "items": { "type": "string" } }
            }
          },
          "suggested_fix": {
            "type": "object",
            "required": ["minimal_change", "files"],
            "additionalProperties": false,
            "properties": {
              "minimal_change": { "type": "string" },
              "files": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "should_fix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "area", "description", "evidence", "suggested_fix"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "area": { "type": "string" },
          "description": { "type": "string" },
          "evidence": {
            "type": "object",
            "required": ["files", "notes"],
            "additionalProperties": false,
            "properties": {
              "files": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "array", "items": { "type": "string" } }
            }
          },
          "suggested_fix": {
            "type": "object",
            "required": ["minimal_change", "files"],
            "additionalProperties": false,
            "properties": {
              "minimal_change": { "type": "string" },
              "files": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["need", "how_to_get", "files"],
        "additionalProperties": false,
        "properties": {
          "need": { "type": "string" },
          "how_to_get": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "visual_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_path", "observed", "read_bytes"],
        "additionalProperties": false,
        "properties": {
          "artifact_path": { "type": "string" },
          "observed": { "type": "array", "items": { "type": "string" } },
          "read_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "go_no_go": { "type": "string", "enum": ["go", "no_go", "conditional_go"] }
  },
  "$examples": [
    {
      "scores": { "severity": 0, "confidence": "high" },
      "must_fix": [],
      "should_fix": [],
      "missing_evidence": [],
      "visual_evidence": [],
      "go_no_go": "go"
    }
  ]
}
