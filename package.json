{
  "name": "pn-core",
  "version": "0.18.7",
  "description": "pnCore — MCP server, skills, agents, commands, rules",
  "private": true,
  "type": "module",
  "bin": {
    "pn-core": "packages/pn-core-mcp/dist/index.js",
    "pn-core-mcp": "packages/pn-core-mcp/dist/index.js",
    "pn-core-install": "scripts/install-to-project.mjs"
  },
  "scripts": {
    "validate": "npm run format:check && node scripts/validate-parallel.mjs && node scripts/validate-workflow-contract.mjs && node scripts/validate-skill-schema.mjs && node scripts/validate-skeptic-gates.mjs && node scripts/check-doc-inventory.mjs",
    "validate:skill-security": "node scripts/validate-skill-security.mjs",
    "report:gates": "node scripts/report-gates.mjs",
    "check:content-sync": "node scripts/check-content-plugin-sync.mjs",
    "check:context-index": "node scripts/check-context-index.mjs",
    "migrate:context-index": "node scripts/migrate-context-index.mjs",
    "check:ac-traceability": "node scripts/check-ac-traceability.mjs",
    "check:changelog": "node scripts/validate-changelog.mjs",
    "check:doc-structure": "node scripts/validate-doc-structure.mjs",
    "prune:actions": "node scripts/github-actions-prune-runs.mjs",
    "prune:actions:dry-run": "node scripts/github-actions-prune-runs.mjs --dry-run",
    "check:embedded-studio-urls": "node scripts/check-embedded-studio-urls.mjs",
    "check:links": "node scripts/check-doc-links.mjs",
    "check:evals": "node scripts/validate-eval-yaml.mjs",
    "scaffold:eval": "node scripts/scaffold-eval.mjs",
    "list:eval-backfill": "node scripts/list-eval-backfill.mjs",
    "test": "npm run test --prefix packages/pn-core-mcp",
    "test:coverage": "npm run test:coverage --prefix packages/pn-core-mcp",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:full": "npm run lint && npm run sync:content && npm run build:mcp && npm run test:coverage && npm run test:scripts && npm run smoke:npx-mcp && npm run validate",
    "build:mcp": "npm install --prefix packages/pn-core-mcp --include=dev && npm run build --prefix packages/pn-core-mcp",
    "sync:content": "node scripts/sync-content-to-plugin.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "postversion": "npm run sync:version",
    "setup": "npm install && npm run build:mcp && node scripts/setup-hooks.mjs",
    "plugin-install": "node scripts/install-to-project.mjs",
    "prepare": "node scripts/prepare-root.mjs",
    "mcp-config": "node scripts/mcp-config-write.mjs",
    "mcp-config:dev": "node scripts/mcp-config-write.mjs",
    "mcp-config:portable": "node scripts/mcp-config-portable.mjs",
    "mcp-pin": "npm run build:mcp && npm run mcp-config:dev",
    "check:mcp": "node scripts/check-mcp-config.mjs",
    "smoke:npx-mcp": "node scripts/smoke-npx-mcp-install.mjs",
    "dashboard": "node scripts/dashboard-server.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:write": "node scripts/bench.mjs --write",
    "measure-tokens": "node scripts/measure-tokens.mjs",
    "measure-tokens:write": "node scripts/measure-tokens.mjs --write",
    "mcp-deeplink": "node scripts/mcp-deeplink.mjs",
    "lint": "eslint packages/pn-core-mcp/src scripts",
    "format": "prettier --write \"packages/pn-core-mcp/src/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"packages/pn-core-mcp/src/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "typebox": "^1.3.13",
    "zod": "4.4.3"
  },
  "overrides": {
    "zod": "4.4.3",
    "ip-address": "10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./plugins/pnCore/skills"
    ],
    "extensions": [
      "./packages/pn-core-mcp/extensions/pn-core.ts"
    ]
  }
}
